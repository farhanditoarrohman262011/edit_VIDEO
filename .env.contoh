# Salin jadi .env lalu isi SALAH SATU. File .env tidak ikut dibagikan.
# AI = lokal | gemini | claude | openai
AI=lokal

# Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# OpenAI-compatible: Ollama lokal gratis (default), OpenAI, OpenRouter, Groq, dll.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1
